# --- Environment files ---
.env
.env.local
**/.env
!**/.env.example

# --- Node ---
node_modules/
client/dist/
client/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Server uploads (user-generated content, not source) ---
server/uploads/*
!server/uploads/**/.gitkeep

# --- Python ---
python-monitoring/venv/
python-monitoring/__pycache__/
python-monitoring/app/**/__pycache__/
*.pyc

# --- Downloaded AI model weights (large binary, documented in README instead) ---
python-monitoring/app/models/*.pt
python-monitoring/app/models/*.onnx

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.log

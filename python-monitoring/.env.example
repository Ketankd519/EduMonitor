# Port this service runs on
PORT=8000

# Only Node's server is expected to call this service
NODE_SERVER_URL=http://localhost:5000

# Phase 9: path to downloaded YOLO weights (e.g. yolov8n.pt)
YOLO_MODEL_PATH=app/models/yolov8n.pt

# Phase 9: minimum confidence to count as a positive phone detection
PHONE_DETECTION_CONFIDENCE=0.5
